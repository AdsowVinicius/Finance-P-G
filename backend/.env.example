# Copie este arquivo pra .env e preencha com os valores reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Banco de dados
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/pgfinance

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT — gere uma chave aleatória forte (ex: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos (PDF nota, boleto)
STORAGE_DIR=./storage

# Consulta de NFe (opção 3, sem certificado) — Meu Danfe, R$0,03/consulta
MEUDANFE_API_KEY=sua-chave-meudanfe-aqui
MEUDANFE_BASE_URL=https://api.meudanfe.com.br/v2

# RF16 — assistente de consulta em linguagem natural (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
# ANTHROPIC_MODEL=claude-haiku-4-5

# WhatsApp — Meta Cloud API oficial. Token de sistema (via Business Settings do
# Meta for Developers), ID do número e verify token/app secret do webhook.
WHATSAPP_ACCESS_TOKEN=seu-token-de-sistema-meta-aqui
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id-aqui
WHATSAPP_VERIFY_TOKEN=escolha-um-verify-token-proprio
WHATSAPP_APP_SECRET=seu-app-secret-meta-aqui
