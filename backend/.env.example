# Banco de dados
DATABASE_URL=postgresql+psycopg2://pgfinance:pgfinance@localhost:5432/pgfinance

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=troque-isso-por-um-valor-aleatorio-forte
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173

# Armazenamento de arquivos (PDF nota, boleto)
STORAGE_DIR=./storage

# Consulta de NFe (opção 3, sem certificado) — cadastre-se em meudanfe.com.br,
# crie uma Api-Key no menu API/Integração. R$0,03 por consulta de NF-e.
MEUDANFE_API_KEY=
MEUDANFE_BASE_URL=https://api.meudanfe.com.br/v2
